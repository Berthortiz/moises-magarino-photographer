---
interface Props {
    href?: string;
    text?: string;
    class?: string;
}

const {
    href = "#",
    text = "Contáctame Ahora",
    class: className = "",
} = Astro.props;
---

<a href={href} class={`btn-shine group ${className}`}>
    <slot />
    <span>{text}</span>
</a>

<style>
    /* 
    Definimos la animación y el pseudo-elemento localmente en el estilo del componente.
    Mantenemos el overflow-hidden en Tailwind, pero controlamos el pseudo-elemento aquí.
  */
    .btn-shine {
        display: flex;
        border-radius: 10px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease-in-out 0.2s;
    }

    .btn-shine::before {
        content: "";
        position: absolute;
        top: -10px;
        bottom: -10px;
        width: 30%;
        background: linear-gradient(
            to right,
            transparent 0%,
            rgba(180, 180, 180, 0.84) 50%,
            transparent 100%
        );

        transform: skew(-30deg) translateX(-260%);
        transition: all 0.5s ease-in-out;
    }
    @media (hover: hover) and (pointer: fine) {
        .btn-shine:hover {
            background: #06060687;
        }

        .btn-shine:hover::before {
            transform: skew(-30deg) translateX(430%);
        }
    }

    @media (max-width: 639px) {
        .btn-shine:hover::before {
            animation: mobile-shine-sweep 0.8s ease-in-out forwards;
        }

        @keyframes mobile-shine-sweep {
            from {
                transform: skew(-30deg) translateX(-190%);
            }

            to {
                transform: skew(-30deg) translateX(430%);
            }
        }
    }

    /* @keyframes shine {
        0% {
            transform: skew(-30deg) translateX(-130%);
        }
        100% {
            transform: skew(-30deg) translateX(400%);
        }
    } */
</style>
