---
interface SlideData {
    src: string;
    alt?: string;
}

interface Props {
    slides?: SlideData[];
    alt?: string;
}

import img14 from "../assets/img/slider-about-scroll/img14.jpg";
import img15 from "../assets/img/slider-about-scroll/img15.jpg";
import img29 from "../assets/img/slider-about-scroll/img29.jpg";

const { slides, alt = "Fotografía de Moisés Magariño" } = Astro.props;

const defaultSlides: SlideData[] = [
    { src: img14.src, alt: `${alt} — 1` },
    { src: img15.src, alt: `${alt} — 2` },
    { src: img29.src, alt: `${alt} — 3` },
];

const items = slides?.length ? slides : defaultSlides;
---

<div
    class="swiper blur-slider"
    data-blur-slider
    aria-label="Galería automática de fotos"
>
    <div class="swiper-wrapper">
        {
            items.map((slide, i) => (
                <div class={`swiper-slide${i === 0 ? " swiper-slide-active" : ""}`}>
                    <img
                        src={slide.src}
                        alt={slide.alt || alt}
                        loading={i === 0 ? "eager" : "lazy"}
                        decoding="async"
                        draggable="false"
                    />
                </div>
            ))
        }
    </div>
</div>

<style>
    .blur-slider {
        position: relative;
        height: 500px;
        border-radius: 20px;
        overflow: hidden;
    }

    .blur-slider .swiper-slide {
        opacity: 0;
        filter: blur(18px);
        transition:
            opacity 1s ease,
            filter 1s ease;
        pointer-events: none;
    }

    .blur-slider .swiper-slide-active {
        opacity: 1;
        filter: blur(0px);
    }

    .blur-slider .swiper-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        user-select: none;
    }

    @media (max-width: 768px) {
        .blur-slider {
            height: 400px;
        }

        .blur-slider .swiper-slide {
            filter: blur(14px);
        }
    }
</style>

<script>
    import Swiper from "swiper";
    import { Autoplay } from "swiper/modules";
    import "swiper/css";

    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    document
        .querySelectorAll<HTMLElement>("[data-blur-slider]")
        .forEach((el) => {
            const slides = el.querySelectorAll(".swiper-slide").length;

            if (slides < 2 || reduceMotion) return;

            new Swiper(el, {
                modules: [Autoplay],
                loop: true,
                speed: 0,
                autoplay: {
                    delay: 3000,
                    disableOnInteraction: false,
                },
                allowTouchMove: false,
                simulateTouch: false,
            });
        });
</script>
