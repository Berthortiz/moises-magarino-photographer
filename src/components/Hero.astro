---
import { Image } from "astro:assets";
import ButtonPrimary from "./ButtonPrimary.astro";
import heroImage from "../assets/img/hero-photographer-unsplash.jpg";
---

<section class="hero w-full">
    <div
        class="hero-content mx-auto grid min-h-[85svh] max-w-7xl items-center gap-12 px-6 py-14 md:px-[var(--padding-all-web)] lg:grid-cols-2 lg:gap-16"
    >
        <div class="hero-copy flex flex-col items-start">
            <h1
                class="mb-6 max-w-xl font-serif text-5xl font-normal leading-[1.02] text-white sm:text-6xl lg:text-7xl"
            >
                Black &amp; white Moments
            </h1>
            <p
                class="mb-9 max-w-md text-base leading-7 text-gray-300 sm:text-lg"
            >
                &quot;Aenean ultricies mi vitae est. Mauris placerat eleifend
                leo. Quisque sit amet est et sapien ullamcorper pharetra.&quot;
            </p>
            <ButtonPrimary
                title="Ver Portafolio"
                link="#proyects"
                additionalClass="w-full items-center justify-center border border-white/50 px-5 py-3 text-sm text-white transition-colors hover:border-white hover:bg-white hover:text-(--color-text-black) sm:w-fit"
                bg="transparent"
            />
        </div>

        <div
            class="hero-photo relative mx-auto w-full max-w-[34rem] overflow-hidden border border-white/10"
        >
            <Image
                src={heroImage}
                alt="Fotógrafa sosteniendo su cámara durante una sesión"
                class="h-full w-full object-cover object-[63%_center]"
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 42vw, 90vw"
                loading="eager"
            />
        </div>
    </div>
</section>

<style>
    .hero {
        background:
            radial-gradient(
                ellipse at 78% 48%,
                rgba(255, 255, 255, 0.055),
                transparent 42%
            ),
            var(--color-bg);
    }

    .hero-photo {
        aspect-ratio: 4 / 5;
        max-height: 680px;
    }

    .hero-photo::after {
        position: absolute;
        inset: 45% 0 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.58));
        content: "";
        pointer-events: none;
    }

    @media (max-width: 640px) {
        .hero-photo {
            aspect-ratio: 4 / 3;
        }
    }
</style>
