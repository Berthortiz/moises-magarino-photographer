---
// Puedes definir props si quieres que la imagen o los textos sean dinámicos
import moisesAbout from "../assets/img/moises-about.jpg";

interface Props {
    imageSrc?: string;
    imageAlt?: string;
    title?: string;
}

const {
    imageSrc = moisesAbout.src,
    imageAlt = "Retrato fotográfico",
    title = "Hola, soy Moisés",
} = Astro.props;
---

<section class="about-section">
    <div class="about-container">
        <!-- Columna de la imagen -->
        <div class="about-image-wrapper">
            <img src={imageSrc} alt={imageAlt} />
        </div>

        <!-- Columna de contenido -->
        <div class="about-content">
            <div class="about-tag">
                <!-- <span class="number">02</span> -->
                <span class="label">SOBRE MÍ</span>
            </div>

            <h2>{title}</h2>

            <p>
                Soy Moisés Magariño, fotógrafo y creador audiovisual. Me gusta
                descubrir lo que hace única a cada historia: la emoción de una
                celebración, la energía de un concierto o la personalidad de un
                espacio.
            </p>

            <p>
                Trabajo con personas, marcas y proyectos alrededor del mundo,
                creando fotografías y videos con intención, atención a la luz y
                cuidado por cada detalle. Quiero que cada imagen no solo
                documente lo que pasó, sino que te ayude a volver a sentirlo.
            </p>

            <div class="about-signature">Moisés Magariño</div>
        </div>
    </div>
</section>

<style>
    /* Estilos generales de la sección */
    .about-section {
        background:
            radial-gradient(
                ellipse 24% 30% at 78% 48%,
                rgba(255, 255, 255, 0.095) 0%,
                rgba(255, 255, 255, 0.045) 38%,
                transparent 100%
            ),
            radial-gradient(
                ellipse 22% 28% at 22% 68%,
                rgba(143, 165, 178, 0.08) 0%,
                rgba(143, 165, 178, 0.035) 38%,
                transparent 100%
            ),
            var(--color-bg);
        background-size:
            130% 130%,
            130% 130%,
            auto;
        background-repeat: no-repeat, no-repeat;
        background-position:
            0% 0%,
            100% 100%,
            0 0;
        animation: about-gradient-drift 6s ease-in-out infinite alternate;
        padding: 80px 20px;
        font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @keyframes about-gradient-drift {
        from {
            background-position:
                0% 0%,
                100% 100%,
                0 0;
        }
        to {
            background-position:
                100% 100%,
                0% 0%,
                0 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-section {
            animation: none;
        }
    }

    .about-container {
        max-width: 1100px;
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    /* Imagen con esquinas redondeadas estilo moderno */
    .about-image-wrapper img {
        width: 100%;
        height: 500px;
        object-fit: cover;
        transform: scaleX(-1);
        border-radius: 20px;
        display: block;
    }

    /* Textos y tipografía */
    .about-content {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .about-tag {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #fff;
    }

    .about-tag .number {
        background-color: #e3ded8;
        padding: 4px 8px;
        color: black;
        font-weight: 600;
    }

    .about-content h2 {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 2.5rem;
        font-weight: 400;
        margin: 0;
        color: #fff;
    }

    .about-content p {
        font-size: 1rem;
        line-height: 1.6;
        color: #ffffff90;
        margin: 0;
    }

    .about-signature {
        font-family: "Brush Script MT", cursive, sans-serif;
        font-size: 1.8rem;
        /* color: ; */
        margin-top: 10px;
    }

    /* Responsivo para móviles */
    @media (max-width: 768px) {
        .about-container {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .about-image-wrapper img {
            height: 400px;
        }

        .about-content h2 {
            font-size: 2rem;
        }
    }
</style>
