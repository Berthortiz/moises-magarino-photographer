---
// bodas
import modaImg from "../assets/img/galleryFilter/bodas/pexels-luisbecerrafotografo-5824565.jpg";
import weddingCoupleRiver from "../assets/img/galleryFilter/bodas/wedding-couple-sean-williams.jpg";
import weddingBrideBouquet from "../assets/img/galleryFilter/bodas/wedding-bride-eugenia-pankiv.jpg";
import weddingCoupleForest from "../assets/img/galleryFilter/bodas/wedding-couple-forest-eugenia-pankiv.jpg";
import weddingKiss from "../assets/img/galleryFilter/bodas/wedding-kiss-ak-camz.jpg";
import weddingWalk from "../assets/img/galleryFilter/bodas/wedding-walk-ak-camz.jpg";

// Conciertos
import conciertosImg1 from "../assets/img/galleryFilter/conciertos/pexels-thibault-trillet-44912-167491.jpg";
import conciertosImg2 from "../assets/img/galleryFilter/conciertos/pexels-alexandreeliasfotografia-elias-2159734286-36257830.jpg";
import concertCrowd from "../assets/img/galleryFilter/conciertos/concert-crowd-sebastian-ervi.jpg";
import concertAudience from "../assets/img/galleryFilter/conciertos/concert-audience-spencer-davis.jpg";
import concertPhone from "../assets/img/galleryFilter/conciertos/concert-phone-noiseporn.jpg";
import concertSilhouette from "../assets/img/galleryFilter/conciertos/concert-crowd-diane-picchiottino.jpg";

// realestate
import realestate1 from "../assets/img/galleryFilter/realestate/pexels-bluerhinomedia-3665354.jpg";
import livingRoom from "../assets/img/galleryFilter/realestate/realestate-living-room-huy-nguyen.jpg";
import redSofaLivingRoom from "../assets/img/galleryFilter/realestate/realestate-living-room-austin-wehrwein.jpg";
import modernHouse from "../assets/img/galleryFilter/realestate/realestate-house-ibrahim-design.jpg";
import whiteHouse from "../assets/img/galleryFilter/realestate/realestate-house-felix.jpg";
import illuminatedHouse from "../assets/img/galleryFilter/realestate/realestate-house-arthur-baudry.jpg";

const Gallery = [
    {
        category: "bodas",
        pictures: [
            { src: modaImg.src, alt: "Detalle de boda" },
            {
                src: weddingCoupleRiver.src,
                alt: "Pareja con atuendo tradicional de boda junto a un río",
            },
            {
                src: weddingBrideBouquet.src,
                alt: "Novia con vestido blanco y ramo de flores",
            },
            {
                src: weddingCoupleForest.src,
                alt: "Pareja de recién casados rodeada de árboles",
            },
            {
                src: weddingKiss.src,
                alt: "Novios besándose durante una sesión de boda en el bosque",
            },
            {
                src: weddingWalk.src,
                alt: "Novios caminando juntos por un sendero",
            },
        ],
    },
    {
        category: "conciertos",
        pictures: [
            { src: conciertosImg1.src, alt: "Concierto 1" },
            { src: conciertosImg2.src, alt: "Concierto 2" },
            {
                src: concertCrowd.src,
                alt: "Siluetas del público frente al escenario de un concierto",
            },
            {
                src: concertAudience.src,
                alt: "Público disfrutando de un concierto nocturno",
            },
            {
                src: concertPhone.src,
                alt: "Asistente grabando un concierto con su teléfono",
            },
            {
                src: concertSilhouette.src,
                alt: "Público con las manos levantadas durante un concierto",
            },
        ],
    },
    {
        category: "realestate",
        pictures: [
            { src: realestate1.src, alt: "Propiedad inmobiliaria" },
            { src: livingRoom.src, alt: "Sala moderna de concepto abierto" },
            {
                src: redSofaLivingRoom.src,
                alt: "Sala de estar con sofá rojo y alfombra gris",
            },
            {
                src: modernHouse.src,
                alt: "Casa moderna de tres plantas con paneles de madera",
            },
            {
                src: whiteHouse.src,
                alt: "Fachada de una casa blanca bajo el cielo azul",
            },
            {
                src: illuminatedHouse.src,
                alt: "Exterior de una casa moderna iluminada por la noche",
            },
        ],
    },
];
---

<!-- PhotoSwipe CSS desde CDN -->
<head>
    <link
        rel="stylesheet"
        href="https://unpkg.com/photoswipe@5/dist/photoswipe.css"
    />
</head>
<section id="galeria" class="text-white px-6 py-18 lg:px-(--padding-all-web)">
    <div class="max-w-6xl mx-auto py-8">
        <!-- Pestañas de Filtrado -->
        <h1
            class="title-font leading-10 md:leading-10 font-bold text-center text-4xl
        sm:text-4xl md:text-4xl lg:text-4xl mb-4 text-gray-100"
        >
            <span class="gradiente-title-hero">
                Gallery
                <!-- Donec eu libero sit amet quam egestas semper. Aenean ultricies mi vitae est. Mauris placerat eleifend leo. Quisque sit amet est et sapien ullamcorper pharetra. -->
            </span>
        </h1>
        <div
            class="flex flex-wrap justify-center gap-6 mb-8 text-sm font-bold tracking-widest"
        >
            <button
                class="tab-btn cursor-pointer text-amber-500 border-b-2 border-amber-500 pb-1"
                data-category="all">All</button
            >
            <button
                class="tab-btn cursor-pointer text-gray-400 hover:text-white pb-1"
                data-category="bodas">Bodas</button
            >
            <button
                class="tab-btn cursor-pointer text-gray-400 hover:text-white pb-1"
                data-category="conciertos">Conciertos</button
            >
            <button
                class="tab-btn cursor-pointer text-gray-400 hover:text-white pb-1"
                data-category="realestate">Real Estate</button
            >
        </div>

        <!-- Rejilla de Imágenes -->
        <div id="gallery" class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
                Gallery?.map((item) => {
                    return item.pictures?.map((pic) => {
                        return (
                            <a
                                href={pic.src}
                                data-pswp-width="1600"
                                data-pswp-height="1067"
                                data-category={item.category}
                                target="_blank"
                                class="gallery-item group block overflow-hidden rounded-lg aspect-4/3 bg-neutral-900"
                            >
                                <img
                                    src={pic.src}
                                    alt={pic.alt}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                />
                            </a>
                        );
                    });
                })
            }
        </div>
    </div>

    <script type="module">
        import PhotoSwipeLightbox from "https://unpkg.com/photoswipe@5/dist/photoswipe-lightbox.esm.js";

        const lightbox = new PhotoSwipeLightbox({
            gallery: "#gallery",
            children: "a.gallery-item:not(.hidden)",
            pswpModule: () =>
                import("https://unpkg.com/photoswipe@5/dist/photoswipe.esm.js"),
        });
        lightbox.init();

        //  Filtrado
        const buttons = document.querySelectorAll(".tab-btn");
        const items = document.querySelectorAll(".gallery-item");

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const selectedCategory = button.getAttribute("data-category");

                // pestañas
                buttons.forEach((b) => {
                    b.classList.remove(
                        "text-amber-500",
                        "border-b-2",
                        "border-amber-500",
                    );
                    b.classList.add("text-gray-400");
                });
                button.classList.remove("text-gray-400");
                button.classList.add(
                    "text-amber-500",
                    "border-b-2",
                    "border-amber-500",
                );

                items.forEach((item) => {
                    const itemCategory = item.getAttribute("data-category");
                    if (
                        selectedCategory === "all" ||
                        itemCategory === selectedCategory
                    ) {
                        item.classList.remove("hidden");
                    } else {
                        item.classList.add("hidden");
                    }
                });
            });
        });
    </script>
</section>
