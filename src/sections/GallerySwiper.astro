---
import "swiper/css";
import "swiper/css/navigation";

import boda1 from "../assets/img/galleryFilter/bodas/pexels-liichun-film-2162732256-38447645.jpg";
import boda2 from "../assets/img/galleryFilter/bodas/pexels-luisbecerrafotografo-5824565.jpg";
import boda3 from "../assets/img/galleryFilter/bodas/pexels-saplak-19571937.jpg";
import concierto1 from "../assets/img/galleryFilter/conciertos/pexels-alexandreeliasfotografia-elias-2159734286-36257830.jpg";
import realEstate1 from "../assets/img/galleryFilter/realestate/pexels-bluerhinomedia-3665354.jpg";

const imagenes = [
    {
        src: boda1.src,
        width: boda1.width,
        height: boda1.height,
        alt: "Momento especial de boda",
    },
    {
        src: boda2.src,
        width: boda2.width,
        height: boda2.height,
        alt: "Boda con detalle elegante",
    },
    {
        src: boda3.src,
        width: boda3.width,
        height: boda3.height,
        alt: "Celebración en boda",
    },
    {
        src: concierto1.src,
        width: concierto1.width,
        height: concierto1.height,
        alt: "Escena de concierto",
    },
    {
        src: realEstate1.src,
        width: realEstate1.width,
        height: realEstate1.height,
        alt: "Propiedad de lujo",
    },
];

// Duplicamos para que el modo loop tenga suficientes slides
const imagenesLoop = [...imagenes, ...imagenes];
---

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.css"
/>

<section class="gallery-showcase py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-[var(--padding-all-web)]">
        <header
            class="gallery-intro mb-10 flex flex-col items-center gap-5 text-center lg:mb-12"
        >
            <div class="flex flex-col items-center text-center">
                <p
                    class="gallery-kicker mb-5 text-xs font-semibold uppercase text-gray-100 bg-gray-700/40 py-3 px-4 rounded-2xl"
                >
                    Bodas · Conciertos · Espacios
                </p>
                <h2
                    class="max-w-3xl text-center font-serif text-4xl font-normal leading-[1.05] text-white sm:text-5xl lg:text-6xl"
                >
                    Imágenes para volver a sentir cada instante.
                </h2>
            </div>
            <p
                class="max-w-2xl text-center text-base leading-7 text-gray-300 sm:text-lg"
            >
                Una mirada cuidada a las historias, la energía y los lugares que
                merecen quedarse contigo.
            </p>
        </header>

        <div class="swiper relative mx-auto px-4" id="gallery-swiper">
            <div class="swiper-wrapper">
                {
                    imagenesLoop.map((img) => (
                        <div class="swiper-slide h-72 w-72 overflow-hidden border border-white/10 bg-neutral-900 sm:h-80 sm:w-80">
                            <a
                                href={img.src}
                                data-pswp-width={img.width}
                                data-pswp-height={img.height}
                                class="group block h-full w-full cursor-zoom-in"
                            >
                                <img
                                    src={img.src}
                                    alt={img.alt}
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </a>
                        </div>
                    ))
                }
            </div>

            <div class="swiper-button-prev rounded-2xl"></div>
            <div class="swiper-button-next rounded-2xl"></div>
        </div>
    </div>
</section>

<style>
    .gallery-kicker {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .gallery-kicker::befor {
        width: 2rem;
        height: 1px;
        /* background: var(--color-brand-two); */
        content: "";
    }

    #gallery-swiper {
        width: 100%;
        padding-bottom: 20px;
        -webkit-mask-image: linear-gradient(
            to right,
            transparent 0%,
            black 5%,
            black 95%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to right,
            transparent 0%,
            black 5%,
            black 95%,
            transparent 100%
        );
    }

    #gallery-swiper :global(.swiper-wrapper) {
        transition-timing-function: linear !important;
    }

    #gallery-swiper :global(.swiper-button-next),
    #gallery-swiper :global(.swiper-button-prev) {
        color: #fff;
    }

    :global(.pswp__button--close) {
        z-index: 999999 !important;
        pointer-events: auto !important;
    }
</style>

<script>
    // Cada slider necesita un selector propio (id o clase única, ej. .gallery-swiper).
    // Nunca usar ".swiper" solo: agarra todos los sliders de la página.
    // Pasar el elemento a new Swiper(el) y limitar CSS/navigation/PhotoSwipe a ese slider.
    import Swiper from "swiper";
    import { Navigation, Autoplay } from "swiper/modules";

    const swiper = new Swiper("#gallery-swiper", {
        modules: [Navigation, Autoplay],
        loop: true,
        loopPreventsSliding: false,
        speed: 12000,
        slidesPerView: "auto",
        spaceBetween: 20,
        navigation: {
            nextEl: "#gallery-swiper .swiper-button-next",
            prevEl: "#gallery-swiper .swiper-button-prev",
        },
        autoplay: {
            delay: 0,
            disableOnInteraction: false,
        },
        breakpoints: {
            640: { slidesPerView: 2, spaceBetween: 20 },
            1024: { slidesPerView: 3, spaceBetween: 30 },
        },
    });

    import(
        "https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.min.js" as any
    ).then((PhotoSwipeLightboxModule) => {
        const PhotoSwipeLightbox = PhotoSwipeLightboxModule.default;

        const lightbox = new PhotoSwipeLightbox({
            gallery: "#gallery-swiper",
            // Ignora los slides clonados por Swiper
            children: ".swiper-slide:not(.swiper-slide-duplicate) a",
            pswpModule: () =>
                import(
                    "https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.esm.min.js" as any
                ),
        });

        lightbox.on("open", () => swiper.autoplay?.stop());
        lightbox.on("close", () => swiper.autoplay?.start());

        lightbox.init();
    });
</script>
