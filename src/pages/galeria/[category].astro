---
import Layout from "../../layouts/Layout.astro";
import { GALLERY, type GalleryCategory } from "../../data/gallery";

interface Props {
    category: GalleryCategory;
}

export function getStaticPaths() {
    return GALLERY.map((category) => ({
        params: { category: category.slug },
        props: { category },
    }));
}

const { category } = Astro.props;
const title = `${category.title} | Moisés Magariño`;
const pictures = category.pictures.filter(
    (picture) => picture.category === category.label,
);
---

<Layout title={title} description={category.description}>
    <section class="px-6 pb-20 pt-28 text-white sm:pt-36">
        <header class="mx-auto mb-12 max-w-3xl text-center">
            <a
                href="/#galeria"
                class="mb-6 inline-block text-sm text-gray-400 transition-colors hover:text-white"
            >
                ← Volver a la galería
            </a>
            <h1
                class="title-font mb-5 text-4xl font-bold leading-tight text-gray-100 sm:text-5xl lg:text-6xl"
            >
                <span class="gradiente-title-hero">{category.title}</span>
            </h1>
            <p class="mx-auto max-w-[65ch] leading-7 text-gray-300 sm:text-lg">
                {category.description}
            </p>
        </header>

        <div
            class="mx-auto max-w-7xl columns-1 gap-4 sm:columns-2 lg:columns-3 xl:columns-4"
        >
            {
                pictures.map((picture) => (
                    <a
                        href={picture.large}
                        target="_blank"
                        rel="noreferrer"
                        class="mb-4 block break-inside-avoid overflow-hidden rounded-lg bg-neutral-900"
                    >
                        <img
                            src={picture.thumb}
                            srcset={picture.srcset}
                            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                            width={picture.width}
                            height={picture.height}
                            alt={picture.alt}
                            loading="lazy"
                            decoding="async"
                            class="block h-auto w-full transition-transform duration-300 hover:scale-[1.02]"
                        />
                    </a>
                ))
            }
        </div>
    </section>
</Layout>
