---
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import Footer from "../sections/Footer.astro";
import "../css/style.css";

const logo = "/logo-moises.png";

interface Props {
	title: string;
	description: string;
	canonical?: string;
	robots?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogUrl?: string;
	ogType?: "website" | "article" | "profile";
	twitterCard?: "summary" | "summary_large_image";
	showHeader?: boolean;
}

const {
	title,
	description,
	canonical,
	robots,
	ogImage,
	ogImageAlt,
	ogUrl,
	ogType,
	twitterCard,
	showHeader = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={logo} />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={title}
			description={description}
			canonical={canonical}
			robots={robots}
			ogImage={ogImage}
			ogImageAlt={ogImageAlt}
			ogUrl={ogUrl}
			ogType={ogType}
			twitterCard={twitterCard}
		/>
	</head>
	<body>
		{showHeader && <Header />}
		<slot />
		<Footer />
	</body>
</html>

<script></script>
<style is:global>
	:root {
		--color-brand: #73777b; /* plata grafito */
		--color-brand-two: #d9dcdf;
		--color-brand-secundary: #f3f4f6; /* tarjetas, secciones */
		--color-text-primary: #c3c7ca; /* texto principal */
		--color-secundary: #e5e7e9;
		--color-text-black: #0d0f13;
		--color-gray-100: #f3f4f6;

		--grey-titanio: #a7adb4;

		--color-highlight: #c5c9cc; /* para resaltar botones o links */
		--color-bg: #0d0f13; /* fondo */

		--color-error: #dc2626; /* mensajes de error */
		--color-success: #16a34a; /* mensajes de éxito */

		--padding-all-web: 50px;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		background-color: var(--color-bg);
		/* min-height: 200vh; */
		font-family: "Segoe UI";
		transition: width 1s ease;

		/* scrollbar-gutter: stable; */
		/* overflow: hidden; */
	}
	h1,
	h2,
	h3,
	h4 {
		color: #ffffff;
	}

	.text-gray-100 {
		color: var(--color-gray-100);
	}

	.gradiente-title-g {
		--color-gradient: var(--color-brand-two);
		background-image: linear-gradient(
			to right,
			var(--color-brand),
			var(--color-gradient)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.gradiente-title-g {
		color: var(--color-brand);
		/* fallback */
	}
</style>
